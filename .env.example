# Membres autorises a ouvrir l'espace bureau.
# Preferer les identifiants apres la creation des comptes.
VITE_ADMIN_MEMBER_IDS=

# Option de configuration initiale : noms complets separes par des virgules.
# Toute personne pouvant reprendre le meme nom pourrait etre autorisee.
VITE_ADMIN_NAMES=

# Backend Supabase partage entre tous les appareils.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
